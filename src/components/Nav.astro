---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

const textLinks = [
  { label: "Inicio", href: "/" },
  { label: "Menciones", href: "/mentions/" },
  { label: "Acerca", href: "/about/" },
];

const iconLinks = [
  { label: "GitHub", href: "https://github.com/MeruemArt", icon: "github-logo" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/luis-arteaga-07/", icon: "linkedin-logo" },
];
---

<header class="header">
  <nav class="nav-inner wrapper">
    <a href="/" class="logo">
      <Icon icon="MeruemLogo" color="var(--color-accent)" size="1.5em" gradient />
      <span class="logo-text">Luis Arteaga</span>
    </a>

    <ul class="nav-links">
      {textLinks.map(({ label, href }) => (
        <li>
          <a
            aria-current={
              Astro.url.pathname === href ||
              (href !== "/" && Astro.url.pathname.startsWith(href))
                ? "page"
                : undefined
            }
            href={href}
            class="nav-link"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <div class="social-links">
        {iconLinks.map(({ href, icon, label }) => (
          <a href={href} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={label}>
            <Icon icon={icon} size="1.2em" />
          </a>
        ))}
      </div>
      <ThemeToggle />
      <button class="menu-btn" aria-label="Menu" id="menu-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" class="menu-line-top" />
          <line x1="3" y1="12" x2="21" y2="12" class="menu-line-mid" />
          <line x1="3" y1="18" x2="21" y2="18" class="menu-line-bot" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<div class="mobile-menu-overlay" id="mobile-overlay"></div>
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-header">
    <a href="/" class="logo">
      <Icon icon="MeruemLogo" color="var(--color-accent)" size="1.5em" gradient />
      <span class="logo-text">Luis Arteaga</span>
    </a>
    <button class="close-btn" id="close-btn" aria-label="Cerrar menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>
  <ul class="mobile-nav-links">
    {textLinks.map(({ label, href }) => (
      <li>
        <a
          aria-current={
            Astro.url.pathname === href ||
            (href !== "/" && Astro.url.pathname.startsWith(href))
              ? "page"
              : undefined
          }
          href={href}
          class="mobile-nav-link"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
  <div class="mobile-social">
    {iconLinks.map(({ href, icon, label }) => (
      <a href={href} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={label}>
        <Icon icon={icon} size="1.4em" />
      </a>
    ))}
  </div>
</div>

<script>
  function initNav() {
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const overlay = document.getElementById("mobile-overlay");
    const closeBtn = document.getElementById("close-btn");
    const header = document.querySelector(".header");

    if (!menuBtn || !mobileMenu || !overlay || !closeBtn || !header) return;

    const openMenu = () => {
      mobileMenu.classList.add("open");
      overlay.classList.add("open");
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      mobileMenu.classList.remove("open");
      overlay.classList.remove("open");
      document.body.style.overflow = "";
    };

    menuBtn.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);
    overlay.addEventListener("click", closeMenu);

    const onKeyDown = (e) => {
      if (e.key === "Escape") closeMenu();
    };
    document.addEventListener("keydown", onKeyDown);

    const onScroll = () => {
      if (window.pageYOffset > 80) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });

    return function cleanup() {
      menuBtn.removeEventListener("click", openMenu);
      closeBtn.removeEventListener("click", closeMenu);
      overlay.removeEventListener("click", closeMenu);
      document.removeEventListener("keydown", onKeyDown);
      window.removeEventListener("scroll", onScroll);
    };
  }

  let cleanupNav = initNav();

  document.addEventListener("astro:after-swap", function() {
    if (typeof cleanupNav === "function") cleanupNav();
    setTimeout(function() {
      cleanupNav = initNav();
    }, 0);
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 999;
    transition: background-color 0.3s ease, backdrop-filter 0.3s ease, box-shadow 0.3s ease;
  }

  .header.scrolled {
    background: var(--color-glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-glass-border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .nav-links {
    display: none;
    list-style: none;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999rem;
    background: var(--color-surface-secondary);
    border: 1px solid var(--color-border-light);
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 1.125rem;
    border-radius: 999rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s, background-color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: var(--color-accent-glow);
  }

  .nav-link[aria-current="page"] {
    color: white;
    background: var(--gradient-accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .social-links {
    display: none;
    gap: 0.25rem;
  }

  .social-link {
    display: flex;
    padding: 0.375rem;
    border-radius: 0.5rem;
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition: color 0.2s, background-color 0.2s;
  }

  .social-link:hover {
    color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  .menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 0.75rem;
    background: var(--color-surface-secondary);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .menu-btn:hover {
    background: var(--color-accent-glow);
  }

  /* Mobile Menu */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-menu-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(20rem, 80vw);
    z-index: 9999;
    background: var(--color-surface);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.1);
  }

  .mobile-menu.open {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 0.75rem;
    background: var(--color-surface-secondary);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .close-btn:hover {
    background: var(--color-accent-glow);
  }

  .mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 500;
    transition: color 0.2s, background-color 0.2s;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link[aria-current="page"] {
    color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  .mobile-social {
    display: flex;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
  }

  @media (min-width: 50em) {
    .nav-links {
      display: flex;
    }

    .social-links {
      display: flex;
    }

    .menu-btn {
      display: none;
    }
  }
</style>
