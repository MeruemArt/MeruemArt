---
import Icon from './Icon.astro';
---

<theme-toggle>
	<button>
		<span class="sr-only">Dark theme</span>
		<span class="icon light"><Icon icon="sun" /></span>
		<span class="icon dark"><Icon icon="moon-stars" /></span>
	</button>
</theme-toggle>

<style>
	button {
		display: flex;
		border: 0;
		border-radius: 999rem;
		padding: 0;
		background: var(--color-surface-secondary);
		border: 1px solid var(--color-border-light);
		cursor: pointer;
	}

	.icon {
		z-index: 1;
		position: relative;
		display: flex;
		padding: 0.375rem;
		width: 1.75rem;
		height: 1.75rem;
		font-size: var(--text-xs);
		color: var(--color-text-tertiary);
	}

	.icon.light::before {
		content: '';
		z-index: -1;
		position: absolute;
		inset: 1px;
		background: var(--gradient-accent);
		border-radius: 999rem;
	}

	:global(.theme-dark) .icon.light::before {
		transform: translateX(100%);
	}

	/* El icono va sobre un relleno de acento, asi que hereda el token de
	   texto-sobre-acento: en oscuro el blanco fijo daba 2.22-2.82:1. */
	:global(.theme-dark) .icon.dark,
	:global(html:not(.theme-dark)) .icon.light {
		color: var(--color-on-accent);
	}

	@media (prefers-reduced-motion: no-preference) {
		.icon,
		.icon.light::before {
			transition: transform var(--theme-transition), color var(--theme-transition);
		}
	}

	@media (forced-colors: active) {
		.icon.light::before {
			background-color: SelectedItem;
		}
	}
</style>

<script>
	function getThemePref() {
		try {
			if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
				return localStorage.getItem('theme');
			}
			if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
				return 'dark';
			}
		} catch(e) {}
		return 'dark';
	}

	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			if (this._initialized) return;
			this._initialized = true;

			const button = this.querySelector('button')!;

			const setTheme = (dark) => {
				document.documentElement.classList[dark ? 'add' : 'remove']('theme-dark');
				button.setAttribute('aria-pressed', String(dark));
			};

			const isDark = () => document.documentElement.classList.contains('theme-dark');

			setTheme(getThemePref() === 'dark');

			button.addEventListener('click', () => setTheme(!isDark()));

			document.addEventListener('astro:page-load', () => {
				setTheme(getThemePref() === 'dark');
			});
		}
	}

	if (!customElements.get('theme-toggle')) {
		customElements.define('theme-toggle', ThemeToggle);
	}
</script>
