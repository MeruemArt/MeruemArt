<style is:global>
  #christmas-decor {
    display: none;
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  #christmas-decor.is-active {
    display: block;
  }

  .santa-flight {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(18rem, 48vw, 44rem);
    height: auto;
    opacity: 0.92;
    translate: 0 0;
    scale: 1;
    animation: santa-flight 38s linear infinite, santa-distance 38s ease-in-out infinite;
    animation-delay: -12s, -12s;
    filter: drop-shadow(0 0 0.35rem rgba(233, 241, 237, 0.28));
    will-change: transform;
    backface-visibility: hidden;
    contain: paint;
  }

  .santa-silhouette {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }

  .twinkle-stars {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .twinkle-star {
    opacity: 0.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: christmas-star-twinkle 2.4s ease-in-out infinite alternate,
               christmas-star-zigzag 3s ease-in-out infinite alternate;
    will-change: transform;
  }

  .twinkle-two {
    animation-delay: -0.8s, -1s;
  }

  .twinkle-three {
    animation-delay: -1.6s, -2s;
  }

  .star-red {
    fill: #ef6b62;
    color: #ef6b62;
  }

  .star-gold {
    fill: #f4d17a;
    color: #f4d17a;
  }

  .star-green {
    fill: #8fbd76;
    color: #8fbd76;
  }

  .star-blue {
    fill: #86a9d8;
    color: #86a9d8;
  }

  .gift-group {
    position: absolute;
    bottom: 1.25rem;
    height: 5.5rem;
    opacity: 0.78;
    animation: gifts-bob 3.2s ease-in-out infinite alternate;
  }

  .gifts-three {
    left: clamp(1rem, 8vw, 6rem);
    width: 9rem;
  }

  .gifts-two {
    right: clamp(4.5rem, 10vw, 8rem);
    width: 6rem;
    animation-delay: -1.6s;
  }

  .gift {
    position: absolute;
    bottom: 0;
    width: clamp(2.2rem, 4vw, 3.6rem);
    height: auto;
    filter: drop-shadow(0 0 0.55rem rgba(255, 213, 79, 0.25));
  }

  .gift-back {
    bottom: 0.75rem;
    z-index: 0;
  }

  .gift-back-left {
    left: 0;
    transform: rotate(-8deg);
  }

  .gift-back-right {
    right: 0;
    transform: rotate(8deg);
  }

  .gift-front {
    left: 50%;
    z-index: 1;
    transform: translateX(-50%);
  }

  .gifts-two .gift-front {
    right: 0;
    left: auto;
    transform: rotate(4deg);
  }

  .gift-small {
    width: clamp(1.8rem, 3vw, 2.7rem);
  }

  .gift-large {
    width: clamp(2.6rem, 4.5vw, 4rem);
  }

  .gift-red .gift-box {
    fill: #a83d3d;
  }

  .gift-red .gift-lid {
    fill: #c55248;
  }

  .gift-green .gift-box {
    fill: #3c7655;
  }

  .gift-green .gift-lid {
    fill: #57966a;
  }

  .gift-gold .gift-box {
    fill: #ba8137;
  }

  .gift-gold .gift-lid {
    fill: #d2a24d;
  }

  .gift-ribbon,
  .gift-bow {
    fill: #f4d17a;
    filter: drop-shadow(0 0 0.2rem rgba(255, 213, 79, 0.5));
  }

  @media (max-width: 40rem) {
    .santa-flight {
      top: 3rem;
      width: 16rem;
      animation-delay: -15s;
    }

    .gift-group {
      bottom: 0.25rem;
      opacity: 0.35;
    }

    .gifts-three {
      width: 7rem;
    }

    .gifts-two {
      width: 5rem;
    }

    .gift-large {
      width: 2.8rem;
    }

    .gift-small {
      width: 2rem;
    }
  }

  @keyframes santa-flight {
    from {
      translate: calc(-100% - 1rem) 0;
    }
    50% {
      translate: calc(50vw - 50%) -0.5rem;
    }
    to {
      translate: calc(100vw + 1rem) 0;
    }
  }

  @keyframes santa-distance {
    from {
      scale: 0.45;
    }
    50% {
      scale: 0.72;
    }
    to {
      scale: 1;
    }
  }

  @keyframes gifts-bob {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-0.3rem);
    }
  }

  @keyframes christmas-star-twinkle {
    from {
      opacity: 0.2;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes christmas-star-zigzag {
    from {
      transform: translateY(-0.9rem);
    }
    to {
      transform: translateY(0.9rem);
    }
  }

</style>
