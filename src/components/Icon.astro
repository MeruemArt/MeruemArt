---
import type { HTMLAttributes } from "astro/types";
import { iconPaths } from "./iconPaths";

export interface Props {
	icon: keyof typeof iconPaths;
	color?: string;
	gradient?: boolean;
	size?: string;
}

const { color = "currentcolor", gradient, icon, size } = Astro.props;
const raw = iconPaths[icon as keyof typeof iconPaths];

const svgMatch = raw.match(/<svg\s[^>]*?viewBox="([^"]+)"/);
const viewBox = svgMatch ? svgMatch[1] : "0 0 256 256";
const content = svgMatch ? raw.replace(/<svg[^>]*>/i, "").replace(/<\/svg>/i, "") : raw;

const attrs: HTMLAttributes<"svg"> = {};
if (size) attrs.style = { "--size": size };

const gradientId =
	"icon-gradient-" + Math.round(Math.random() * 10e12).toString(36);
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width="40"
	height="40"
	viewBox={viewBox}
	aria-hidden="true"
	stroke={gradient ? `url(#${gradientId})` : color}
	fill={gradient ? `url(#${gradientId})` : color}
	{...attrs}
>
	<g set:html={content} />
	{
		gradient && (
			<linearGradient
				id={gradientId}
				x1="0"
				x2="1"
				y1="0"
				y2="1"
				gradientUnits="objectBoundingBox"
			>
				<stop stop-color="var(--gradient-stop-1)" />
				<stop offset=".5" stop-color="var(--gradient-stop-2)" />
				<stop offset="1" stop-color="var(--gradient-stop-3)" />
			</linearGradient>
		)
	}
</svg>

<style>
	svg {
		vertical-align: middle;
		width: var(--size, 1em);
		height: var(--size, 1em);
	}
</style>
