---
import Icon from './Icon.astro';
---

<section class="skills-section section-padding wrapper">
  <div class="skills-grid stagger-children">
    <div class="skill-card">
      <div class="skill-icon">
        <Icon icon="terminal-window" size="2.5rem" gradient />
      </div>
      <h3 class="skill-title">Desarrollador Backend</h3>
      <p class="skill-desc">Desarrollador de software con experiencia en AWS, scripts en Python, metodología Scrum y creación de APIs.</p>
    </div>
    <div class="skill-card">
      <div class="skill-icon">
        <Icon icon="trophy" size="2.5rem" gradient />
      </div>
      <h3 class="skill-title">En constante aprendizaje</h3>
      <p class="skill-desc">Siempre buscando nuevas oportunidades para aprender y crecer en el campo de la tecnología.</p>
    </div>
    <div class="skill-card">
      <div class="skill-icon">
        <Icon icon="strategy" size="2.5rem" gradient />
      </div>
      <h3 class="skill-title">Enfocado en Estrategia</h3>
      <p class="skill-desc">Con habilidades para desarrollar estrategias efectivas y soluciones innovadoras.</p>
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .skills-grid {
    display: grid;
    gap: 1.5rem;
  }

  .skill-card {
    padding: 2rem;
    background: var(--color-surface-secondary);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
    border-color: var(--color-accent);
  }

  .theme-dark .skill-card:hover {
    box-shadow: 0 12px 40px var(--color-accent-glow);
  }

  .skill-icon {
    margin-bottom: 1.25rem;
  }

  .skill-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .skill-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (min-width: 50em) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
