---
import Icon from "./Icon.astro";
---

<section class="section-padding wrapper">
  <div class="tech-skills-header animate-in">
    <h2 class="tech-skills-title">Habilidades Técnicas</h2>
    <p class="tech-skills-subtitle">Tecnologías con las que he logrado resultados medibles en producción.</p>
  </div>

  <div class="tech-skills-content">
    <div class="category animate-in">
      <h3 class="category-title">Tecnologías en la Nube</h3>
      <div class="skills-grid">
        <div class="tech-card card-hover">
          <div class="tech-card-icon">
            <Icon icon="aws" size="2.5rem" gradient />
          </div>
          <div class="tech-card-body">
            <h4>Amazon Web Services (AWS)</h4>
            <p>Arquitectura multi-región con replicación S3 y DynamoDB global, resolución de vulnerabilidades Security Hub, 99.9% disponibilidad.</p>
            <div class="progress-track">
              <div class="progress-fill" style="width: 90%;"></div>
            </div>
          </div>
        </div>
        <div class="tech-card card-hover">
          <div class="tech-card-icon">
            <Icon icon="azure" size="2.5rem" gradient />
          </div>
          <div class="tech-card-body">
            <h4>Microsoft Azure</h4>
            <p>Gestión de infraestructura cloud y servicios complementarios en entornos multi-nube.</p>
            <div class="progress-track">
              <div class="progress-fill" style="width: 75%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="category animate-in">
      <h3 class="category-title">CI/CD y Automatización</h3>
      <div class="skills-grid">
        <div class="tech-card card-hover">
          <div class="tech-card-icon">
            <Icon icon="azure_devops" size="2.5rem" gradient />
          </div>
          <div class="tech-card-body">
            <h4>Azure Pipelines</h4>
            <p>CI/CD para 8 microservicios, migración de 500+ dependencias Maven, reducción de deploys de 45 a 15 min.</p>
            <div class="progress-track">
              <div class="progress-fill" style="width: 90%;"></div>
            </div>
          </div>
        </div>
        <div class="tech-card card-hover">
          <div class="tech-card-icon">
            <Icon icon="python" size="2.5rem" gradient />
          </div>
          <div class="tech-card-body">
            <h4>Python</h4>
            <p>Más de 15 tests unitarios para lambdas críticas, cobertura de 0% a 85%, reducción de bugs en producción en 50%.</p>
            <div class="progress-track">
              <div class="progress-fill" style="width: 95%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="category animate-in">
      <h3 class="category-title">Sistemas y Control de Versiones</h3>
      <div class="skills-grid">
        <div class="tech-card card-hover">
          <div class="tech-card-icon">
            <Icon icon="docker" size="2.5rem" gradient />
          </div>
          <div class="tech-card-body">
            <h4>Docker</h4>
            <p>Contenedorización de microservicios e integración con AWS Batch para migración de artefactos.</p>
            <div class="progress-track">
              <div class="progress-fill" style="width: 85%;"></div>
            </div>
          </div>
        </div>
        <div class="tech-card card-hover">
          <div class="tech-card-icon">
            <Icon icon="linux" size="2.5rem" gradient />
          </div>
          <div class="tech-card-body">
            <h4>Linux & EC2</h4>
            <p>Administración de servidores, hardenizado de instancias y auto-escalado inteligente en AWS.</p>
            <div class="progress-track">
              <div class="progress-fill" style="width: 85%;"></div>
            </div>
          </div>
        </div>
        <div class="tech-card card-hover">
          <div class="tech-card-icon">
            <Icon icon="git" size="2.5rem" gradient />
          </div>
          <div class="tech-card-body">
            <h4>Git</h4>
            <p>Refactor y estandarización de más de 50 templates CloudFormation, reduciendo 200+ líneas de código duplicado.</p>
            <div class="progress-track">
              <div class="progress-fill" style="width: 95%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tech-skills-header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3rem;
  }

  .tech-skills-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 0.75rem;
  }

  .tech-skills-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
  }

  .category {
    margin-bottom: 3rem;
  }

  .category:last-child {
    margin-bottom: 0;
  }

  .category-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
  }

  .skills-grid {
    display: grid;
    gap: 1rem;
  }

  .tech-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .tech-card:hover {
    border-color: var(--color-accent);
  }

  .tech-card-icon {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-width: 2.5rem;
    padding-top: 0.25rem;
  }

  .tech-card-body {
    flex: 1;
  }

  .tech-card-body h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .tech-card-body p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .progress-track {
    height: 6px;
    background: var(--color-surface-tertiary);
    border-radius: 3px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--gradient-accent);
    border-radius: 3px;
    transition: width 1s ease;
  }

  @media (min-width: 50em) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .category:last-child .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
