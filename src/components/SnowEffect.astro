<div id="snow-container" aria-hidden="true"></div>

<script>
  /* Nevada estacional: activa en noviembre, diciembre y enero.
     Para validarla sin esperar a diciembre hay dos formas:
       1. FECHA_DE_PRUEBA = new Date(2026, 11, 25)  → fija la fecha
       2. /?snow=1                                    → la fuerza en el sitio
     Sin ninguna de las dos corre con la fecha real. */

  declare global {
    interface Window {
      __snowTimer?: number;
    }
  }

  const FECHA_DE_PRUEBA: Date | null = null;

  /* Ventana de la nevada, en hora local del visitante: se enciende el 1 de
     diciembre a las 00:00 y se apaga el 6 de enero a las 23:59. Si el fin
     era 11:59 del mediodia, cambiar hora a 11 y minuto a 59. */
  const INICIO = { mes: 11, dia: 1 };
  const FIN = { mes: 0, dia: 6, hora: 23, minuto: 59 };

  function enVentanaNavidad(fecha: Date) {
    const mes = fecha.getMonth();
    const minutoDelDia = fecha.getHours() * 60 + fecha.getMinutes();

    if (mes === INICIO.mes) return fecha.getDate() >= INICIO.dia;

    if (mes === FIN.mes) {
      if (fecha.getDate() < FIN.dia) return true;
      if (fecha.getDate() > FIN.dia) return false;
      return minutoDelDia <= FIN.hora * 60 + FIN.minuto;
    }

    return false;
  }

  const params = new URLSearchParams(window.location.search);
  const forzar = params.has("snow");

  const ahora = FECHA_DE_PRUEBA ?? new Date();
  const visible =
    forzar || FECHA_DE_PRUEBA !== null || enVentanaNavidad(ahora);

  const motionOk = !window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  function esMovil() {
    return (
      /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
        navigator.userAgent,
      ) || window.innerWidth < 768
    );
  }

  const flakes = ["❅", "❄"];
  const movil = esMovil();

  function crearCopo(container: HTMLElement) {
    const copo = document.createElement("div");
    copo.className = "snowflake";

    const glifo = document.createElement("span");
    glifo.textContent = flakes[Math.floor(Math.random() * flakes.length)];
    copo.appendChild(glifo);

    const duracion = Math.random() * 3 + 5;

    copo.style.left = Math.random() * 100 + "vw";
    copo.style.fontSize =
      (movil ? Math.random() * 14 + 14 : Math.random() * 18 + 18) + "px";
    copo.style.opacity = (Math.random() * 0.45 + 0.35).toFixed(2);
    copo.style.setProperty("--fall-duration", duracion + "s");
    copo.style.setProperty("--sway-distance", Math.random() * 90 + 40 + "px");
    copo.style.setProperty("--sway-duration", (duracion * 0.6).toFixed(2) + "s");

    container.appendChild(copo);
    setTimeout(() => copo.remove(), duracion * 1000);
  }

  function initSnowEffect() {
    if (window.__snowTimer) {
      clearInterval(window.__snowTimer);
      window.__snowTimer = undefined;
    }

    const container = document.getElementById("snow-container");
    if (!container) return;
    container.replaceChildren();

    if (!visible || !motionOk) return;

    window.__snowTimer = setInterval(
      () => crearCopo(container),
      movil ? 600 : 220,
    );
    crearCopo(container);
  }

  /* Con ViewTransitions el contenedor se vuelve a insertar en cada
     navegación, así que se reinicia en astro:page-load. Es idempotente:
     limpia el intervalo anterior antes de crear otro. */
  document.addEventListener("astro:page-load", initSnowEffect);
  initSnowEffect();
</script>

<style is:global>
  /* Por delante del contenido, por detrás de la interfaz, y sin capturar
     clics: de ahí pointer-events none y un z-index acotado. */
  #snow-container {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 20;
    overflow: hidden;
  }

  /* El color sale del tema: copos claros en oscuro, grafitos en claro.
     Con blanco fijo la nevada era 1.06:1 sobre crema, es decir invisible. */
  .snowflake {
    position: absolute;
    top: -3rem;
    color: var(--color-text-primary);
    user-select: none;
    animation: snow-fall var(--fall-duration, 6s) linear forwards;
  }

  .snowflake > span {
    display: block;
    animation: snow-sway var(--sway-duration, 3s) ease-in-out infinite;
  }

  /* Dos animaciones en vez de cuarenta keyframes: la caída va en el
     contenedor y el vaivén en el hijo, porque dos transforms no se suman
     dentro del mismo elemento. */
  @keyframes snow-fall {
    from {
      transform: translateY(-10vh);
    }
    to {
      transform: translateY(110vh);
    }
  }

  @keyframes snow-sway {
    from {
      transform: translateX(calc(var(--sway-distance, 40px) * -1));
    }
    to {
      transform: translateX(var(--sway-distance, 40px));
    }
  }
</style>
