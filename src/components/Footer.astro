---
import Icon from "./Icon.astro";
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrapper footer-inner">
    <div class="footer-brand">
      <p class="copyright">&copy; {currentYear} Luis Arteaga</p>
    </div>
    <div class="footer-links">
      <a href="https://github.com/MeruemArt" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="GitHub">
        <Icon icon="github-logo" size="1.3em" />
      </a>
      <a href="https://www.linkedin.com/in/luis-arteaga-07/" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="LinkedIn">
        <Icon icon="linkedin-logo" size="1.3em" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    margin-top: 5rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .copyright {
    color: var(--color-text-tertiary);
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    gap: 0.75rem;
  }

  .footer-link {
    display: flex;
    padding: 0.5rem;
    border-radius: 0.75rem;
    color: var(--color-text-tertiary);
    transition: color 0.2s, background-color 0.2s;
  }

  .footer-link:hover {
    color: var(--color-accent);
    background: var(--color-accent-glow);
  }

  @media (min-width: 50em) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
