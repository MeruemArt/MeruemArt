---
import "../styles/global.css";
import "@fontsource/public-sans/400.css";
import "@fontsource/public-sans/500.css";
import "@fontsource/public-sans/600.css";
import "@fontsource/public-sans/700.css";
import "@fontsource/rubik/400.css";
import "@fontsource/rubik/500.css";
import "@fontsource/rubik/600.css";
import "@fontsource/rubik/700.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const {
  title = "Luis Arteaga: Developer",
  description = "The personal site of Luis Arteaga",
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="description" property="og:description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<link rel="canonical" href={Astro.url} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:image" content={new URL("/assets/portrait.webp", Astro.site)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL("/assets/portrait.webp", Astro.site)} />

<meta name="theme-color" content="#6c3bd6" />
<link rel="apple-touch-icon" href="/assets/64x64.png" />
<link rel="apple-touch-icon" sizes="128x128" href="/assets/128x128.png" />

<meta name="keywords" content="DevOps, AWS, Python, Automatización, IaC, CloudFormation, CI/CD, Luis Arteaga, Desarrollador Cloud, Azure, Pipelines, Docker" />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />

<script is:inline>
  (function() {
    var theme = 'light';
    try {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        theme = localStorage.getItem('theme');
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        theme = 'dark';
      }
    } catch(e) {}
    if (theme === 'dark') {
      document.documentElement.classList.add('theme-dark');
    }
  })();
</script>
