---
---

<div id="halloween-container" aria-hidden="true" transition:persist>
  <canvas id="halloween-canvas"></canvas>
</div>

<script>
  import { isHalloweenSeason } from "../utils/halloween-season.js";
  import { getBatFrame, getLanternFrame } from "../utils/halloween-scene.js";

  const container = document.getElementById("halloween-container");
  const canvas = document.getElementById("halloween-canvas");
  const context = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const TAU = Math.PI * 2;
  const CYCLE_MS = 120_000;

  if (container && canvas && context) {
    const bats = Array.from({ length: 12 }, () => {
      const depth = Math.random();

      return {
        startProgress: Math.random(),
        crossings: Math.floor(depth * 6) + 6,
        leftward: Math.random() < 0.5,
        baseY: Math.random() * 0.6 + 0.08,
        bobs: Math.floor(Math.random() * 20) + 20,
        bobAmplitude: Math.random() * 0.02 + 0.01,
        bobPhase: Math.random() * TAU,
        flaps: Math.floor(Math.random() * 180) + 420,
        flapPhase: Math.random() * TAU,
        depth,
      };
    }).sort((a, b) => a.depth - b.depth);

    const lanterns = [0.12, 0.38, 0.64, 0.88].map((x) => ({
      x: x + (Math.random() - 0.5) * 0.08,
      bobs: Math.floor(Math.random() * 12) + 24,
      bobPhase: Math.random() * TAU,
      flickers: Math.floor(Math.random() * 300) + 600,
      depth: Math.random() * 0.6 + 0.4,
    }));

    let width = 0;
    let height = 0;
    let tiltX = 0;
    let tiltY = 0;
    let frameId = 0;
    let darkTheme = document.documentElement.classList.contains("theme-dark");

    function rgba(color: number[], alpha: number) {
      return `rgba(${color[0]}, ${color[1]}, ${color[2]}, ${alpha})`;
    }

    function resizeCanvas() {
      const scale = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      context.setTransform(scale, 0, 0, scale, 0, 0);
    }

    function drawMoon() {
      const radius = Math.min(width, height) * 0.09;
      const x = width * 0.78 + tiltX * 8;
      const y = height * 0.14 + tiltY * 8;
      const color = darkTheme ? [255, 204, 128] : [255, 167, 38];
      const alpha = darkTheme ? 0.5 : 0.4;
      const glow = context.createRadialGradient(x, y, 0, x, y, radius * 3.5);

      glow.addColorStop(0, rgba(color, alpha * 0.45));
      glow.addColorStop(1, rgba(color, 0));
      context.fillStyle = glow;
      context.beginPath();
      context.arc(x, y, radius * 3.5, 0, TAU);
      context.fill();

      context.fillStyle = rgba(color, alpha);
      context.beginPath();
      context.arc(x, y, radius, 0, TAU);
      context.fill();

      context.fillStyle = "rgba(0, 0, 0, 0.06)";
      context.beginPath();
      context.arc(x - radius * 0.3, y - radius * 0.2, radius * 0.22, 0, TAU);
      context.fill();
      context.fillStyle = "rgba(0, 0, 0, 0.05)";
      context.beginPath();
      context.arc(x + radius * 0.35, y + radius * 0.3, radius * 0.15, 0, TAU);
      context.fill();
    }

    function drawBat(bat: (typeof bats)[number], progress: number) {
      const frame = getBatFrame(bat, progress, width, height, tiltX, tiltY);
      const size = frame.radius;
      const lift = -frame.flap * size * 0.3;

      if (frame.y < -size || frame.y > height + size) return;

      context.save();
      context.translate(frame.x, frame.y);
      context.fillStyle = rgba(darkTheme ? [156, 127, 196] : [59, 42, 79], frame.alpha);
      context.beginPath();
      context.moveTo(0, -size * 0.08);
      context.lineTo(size * 0.1, -size * 0.05);
      context.quadraticCurveTo(size * 0.3, -size * 0.12 + lift * 0.5, size * 0.5, lift);
      context.quadraticCurveTo(size * 0.42, lift * 0.4 + size * 0.02, size * 0.34, lift * 0.3 + size * 0.06);
      context.quadraticCurveTo(size * 0.26, lift * 0.2, size * 0.18, size * 0.09);
      context.quadraticCurveTo(size * 0.1, size * 0.04, 0, size * 0.12);
      context.quadraticCurveTo(-size * 0.1, size * 0.04, -size * 0.18, size * 0.09);
      context.quadraticCurveTo(-size * 0.26, lift * 0.2, -size * 0.34, lift * 0.3 + size * 0.06);
      context.quadraticCurveTo(-size * 0.42, lift * 0.4 + size * 0.02, -size * 0.5, lift);
      context.quadraticCurveTo(-size * 0.3, -size * 0.12 + lift * 0.5, -size * 0.1, -size * 0.05);
      context.closePath();
      context.moveTo(-size * 0.06, -size * 0.06);
      context.lineTo(-size * 0.05, -size * 0.15);
      context.lineTo(-size * 0.01, -size * 0.08);
      context.closePath();
      context.moveTo(size * 0.06, -size * 0.06);
      context.lineTo(size * 0.05, -size * 0.15);
      context.lineTo(size * 0.01, -size * 0.08);
      context.closePath();
      context.fill();
      context.restore();
    }

    function drawLantern(lantern: (typeof lanterns)[number], progress: number) {
      const frame = getLanternFrame(lantern, progress, width, height, tiltX, tiltY);
      const { x, y, radius, flicker } = frame;
      const pumpkinAlpha = darkTheme ? 0.35 : 0.3;
      const glow = [255, 213, 79];
      const halo = context.createRadialGradient(x, y, 0, x, y, radius * 2.6);

      halo.addColorStop(0, rgba(glow, Math.min(0.22 * flicker, 1)));
      halo.addColorStop(1, rgba(glow, 0));
      context.fillStyle = halo;
      context.beginPath();
      context.arc(x, y, radius * 2.6, 0, TAU);
      context.fill();

      context.save();
      context.globalAlpha = pumpkinAlpha;
      context.fillStyle = "#e65100";
      context.beginPath();
      context.ellipse(x - radius * 0.45, y, radius * 0.65, radius * 0.8, 0, 0, TAU);
      context.ellipse(x + radius * 0.45, y, radius * 0.65, radius * 0.8, 0, 0, TAU);
      context.fill();
      context.fillStyle = "#f57c00";
      context.beginPath();
      context.ellipse(x, y, radius * 0.6, radius * 0.8, 0, 0, TAU);
      context.fill();

      context.fillStyle = "#5d4037";
      context.fillRect(x - radius * 0.08, y - radius, radius * 0.16, radius * 0.3);

      context.globalAlpha = Math.min(pumpkinAlpha * flicker, 1);
      context.fillStyle = rgba(glow, 1);
      context.beginPath();
      context.moveTo(x - radius * 0.42, y - radius * 0.05);
      context.lineTo(x - radius * 0.26, y - radius * 0.38);
      context.lineTo(x - radius * 0.1, y - radius * 0.05);
      context.closePath();
      context.moveTo(x + radius * 0.1, y - radius * 0.05);
      context.lineTo(x + radius * 0.26, y - radius * 0.38);
      context.lineTo(x + radius * 0.42, y - radius * 0.05);
      context.closePath();
      context.moveTo(x - radius * 0.5, y + radius * 0.15);
      context.lineTo(x - radius * 0.25, y + radius * 0.28);
      context.lineTo(x - radius * 0.12, y + radius * 0.18);
      context.lineTo(x, y + radius * 0.3);
      context.lineTo(x + radius * 0.12, y + radius * 0.18);
      context.lineTo(x + radius * 0.25, y + radius * 0.28);
      context.lineTo(x + radius * 0.5, y + radius * 0.15);
      context.lineTo(x + radius * 0.3, y + radius * 0.5);
      context.lineTo(x, y + radius * 0.62);
      context.lineTo(x - radius * 0.3, y + radius * 0.5);
      context.closePath();
      context.fill();
      context.restore();
    }

    function render(timestamp: number) {
      frameId = 0;
      if (!container.classList.contains("is-active")) return;

      const progress = (timestamp % CYCLE_MS) / CYCLE_MS;
      context.clearRect(0, 0, width, height);
      drawMoon();
      bats.forEach((bat) => drawBat(bat, progress));
      lanterns.forEach((lantern) => drawLantern(lantern, progress));
      frameId = requestAnimationFrame(render);
    }

    function updateEffect() {
      const forced = new URLSearchParams(window.location.search).has("halloween");
      const visible = !motionPreference.matches && (forced || isHalloweenSeason(new Date()));
      container.classList.toggle("is-active", visible);

      if (visible && !frameId) {
        resizeCanvas();
        frameId = requestAnimationFrame(render);
      } else if (!visible && frameId) {
        cancelAnimationFrame(frameId);
        frameId = 0;
        context.clearRect(0, 0, width, height);
      }
    }

    window.addEventListener("resize", resizeCanvas, { passive: true });
    document.addEventListener("astro:page-load", updateEffect);
    document.addEventListener("pointermove", (event) => {
      if (event.pointerType === "touch") return;
      tiltX = (event.clientX / window.innerWidth - 0.5) * 2;
      tiltY = (event.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });
    window.addEventListener("deviceorientation", (event) => {
      if (event.gamma === null || event.beta === null) return;
      tiltX = Math.max(-1, Math.min(1, event.gamma / 45));
      tiltY = Math.max(-1, Math.min(1, event.beta / 90));
    }, { passive: true });
    motionPreference.addEventListener("change", updateEffect);
    new MutationObserver(() => {
      darkTheme = document.documentElement.classList.contains("theme-dark");
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    updateEffect();
  }
</script>

<style is:global>
  #halloween-container {
    display: none;
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  #halloween-container.is-active {
    display: block;
  }

  #halloween-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
