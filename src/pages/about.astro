---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import atWork from "../assets/at-work.jpg";

const CV = "/assets/Luis_Carlos_Arteaga_Espitia_CV.pdf";

const experiencia = [
  {
    periodo: "2026 —",
    titulo: "DevOps Engineer",
    empresa: "Inter Rapidisimo — Bogotá, Colombia",
    fecha: "Mar 2026 — Presente",
    logros: [
      "Diseñé plantillas CI/CD parametrizadas y reutilizables en Azure DevOps YAML para Angular, Next.js, PHP, .NET (ECS y EKS), Python serverless (SAM), microservicios de IA (AgentCore) y migraciones SQL, estandarizando el pipeline para toda la organización.",
      "Integré Veracode (SAST y autoempaquetado), Trivy (SCA), SonarCloud y SBOM en todos los pipelines, y cacheé los binarios de Veracode CLI y Trivy con la tarea Cache@2 para acelerar cada ejecución.",
      "Diseñé la etapa CD para microservicios Python serverless sobre AWS SAM (Lambda y layers gestionadas con uv), con despliegue por ambiente (dev/qa/prd), inyección de variables y validación que aborta ante placeholders sin resolver.",
      "Construí el despliegue a EKS (namespaces, service accounts, ingress, health checks y Fargate) y a ECS/ECR para .NET, reemplazando Release Pipelines clásicos por YAML y asumiendo rol multi-cuenta (dev/qa/prod) con verificación de identidad.",
      "Desarrollé un orquestador de migraciones SQL multi-statement con suite de pruebas (pytest y cobertura) y lint con sqlfluff, más Git tagging con versionamiento semántico.",
      "Definí Quality Gates en SonarCloud con tres niveles y configuré cobertura con Coverlet y ReportGenerator, estableciendo estándares medibles para todos los proyectos.",
      "Desarrollé un sistema de 12 scripts PowerShell que automatiza el ciclo de vida completo de Work Items en Azure DevOps, incluyendo validación de tiempos con festivos colombianos y monitoreo post-despliegue.",
    ],
  },
  {
    periodo: "2022 — 2026",
    titulo: "Developer",
    empresa: "Cobis Topaz — Montería, Colombia",
    fecha: "Mar 2022 — Mar 2026",
    logros: [
      "Resolví más de 10 vulnerabilidades críticas de AWS Security Hub en infraestructura CloudFormation, mejorando la postura de seguridad en 40%.",
      "Diseñé e implementé arquitectura multi-región con replicación automática de buckets S3 y tablas DynamoDB globales, reduciendo el RPO a menos de 1 hora.",
      "Refactoricé el template padre de CloudFormation optimizando uso de recursos, eliminando más de 30 recursos redundantes y reduciendo costos en 800 dólares mensuales.",
      "Estandaricé más de 50 templates convirtiendo documentos SSM a YAML y eliminando más de 200 líneas de código duplicado, mejorando la mantenibilidad en 35%.",
      "Desarrollé una suite de más de 15 tests unitarios para Lambdas críticas en Python, aumentando la cobertura de código de 0% a 85%.",
      "Implementé soporte para despliegue de artifacts CWC base en pipelines de Azure DevOps, habilitando CI/CD para 8 microservicios.",
      "Configuré DeletionProtectionEnabled para una instancia Nexus crítica y ajusté roles IAM de Chatbot, asegurando cumplimiento con AWS Well-Architected Framework.",
      "Contribuí al diseño de dashboards CloudWatch y al desarrollo de una Lambda de autoescalado inteligente para agentes de Azure DevOps, reduciendo costos de cómputo en 25%.",
    ],
  },
];

const educacion = [
  {
    titulo: "Ingeniería de Sistemas",
    institucion: "Universidad del Sinú — Elías Bechara Zainúm",
    detalle: "Graduado con honores y becado.",
    destacado:
      "Proyecto destacado: diseño e implementación de un asistente virtual (chatbot) para el Centro educativo Mata de Caña.",
  },
  {
    titulo: "Técnico en Sistemas",
    institucion: "Politécnico Indes",
    detalle: "Operador de sistemas teleinformáticos y aplicaciones multimedia.",
  },
];
---

<BaseLayout
  title="Acerca de | Luis Arteaga"
  description="DevOps Engineer con más de 4 años de experiencia en AWS, Azure DevOps, IaC y automatización CI/CD."
>
  <div class="shell">
    <div class="column">
      <section class="hero">
        <div class="hero-text">
          <h1 class="hero-title">Luis Arteaga</h1>
          <p class="hero-lede">
            DevOps Engineer con más de cuatro años de experiencia en
            infraestructura como código, CI/CD y seguridad cloud en AWS y Azure
            DevOps. Mi trabajo es que el despliegue deje de ser un ritual
            manual y pase a ser una propiedad del pipeline.
          </p>
        </div>

        <div class="hero-figure">
          <Image
            src={atWork}
            alt="Luis Arteaga trabajando con un colega"
            width={320}
            height={180}
            densities={[1, 2]}
            loading="lazy"
            decoding="async"
            class="about-photo"
          />
        </div>
      </section>

      <aside class="rail">
        <dl class="rail-facts">
          <div class="fact">
            <dt>Rol</dt>
            <dd>DevOps Engineer</dd>
          </div>
          <div class="fact">
            <dt>Foco</dt>
            <dd>CI/CD · Cloud · Automatización</dd>
          </div>
          <div class="fact">
            <dt>Sector</dt>
            <dd>Banca y logística</dd>
          </div>
          <div class="fact">
            <dt>Base</dt>
            <dd>Montería, Colombia</dd>
          </div>
        </dl>
        <a class="rail-link" href={CV} download>
          Currículum <span aria-hidden="true">↓</span>
        </a>
      </aside>

      <section class="block">
        <h2 class="block-title">Experiencia</h2>
        <ol class="rows">
          {
            experiencia.map((e) => (
              <li class="row">
                <p class="row-mark">{e.periodo}</p>
                <div class="row-body">
                  <h3 class="row-title">{e.titulo}</h3>
                  <p class="row-meta">
                    {e.empresa} · {e.fecha}
                  </p>
                  <ul class="logros">
                    {e.logros.map((l) => (
                      <li>{l}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="block">
        <h2 class="block-title">Educación</h2>
        <ol class="rows">
          {
            educacion.map((e) => (
              <li class="row">
                <div class="row-body">
                  <h3 class="row-title">{e.titulo}</h3>
                  <p class="row-meta">{e.institucion}</p>
                  <p class="row-detail">{e.detalle}</p>
                  {e.destacado && <p class="row-detail">{e.destacado}</p>}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <ContactCTA />
    </div>
  </div>

  <WhatsAppButton />
</BaseLayout>

<style>
  /* El hero, el titulo y la entradilla viven en shell.css: aqui no se
     redefinen. Ver el comentario de por que. */

  /* La foto de trabajo entra al hero con el mismo reparto que el retrato del
     inicio: la imagen en la columna de titulos y el texto en la de
     contenido, ambos alineados al pie. Reutilizar el patron es lo que hace
     que las dos paginas se lean como el mismo sistema y no como dos recursos
     pegados. Por eso el titulo y la entradilla van envueltos en .hero-text:
     sueltos ocuparian las dos columnas y la foto no tendria sitio al lado
     del texto. */
  .hero-figure {
    min-width: 0;
  }

  @media (min-width: 64em) {
    .hero-figure {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-text {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* 20rem es el ancho exacto de la columna de titulos. */
  .about-photo {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    aspect-ratio: 1553 / 873;
    object-fit: cover;
    border-radius: 1.5rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }
</style>
