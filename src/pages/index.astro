---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import { Image } from "astro:assets";
import portraitImg from "../assets/portrait.webp";
import cobisLogo from "../assets/cobis.svg";

/* El registro cuantificado. Cada cifra sale de /about/, donde ya está
   publicada y es verificable. No se infla ni se redondea. */
const CV = "/assets/Luis_Carlos_Arteaga_Espitia_CV.pdf";

const resultados = [
  {
    area: "Estandarización",
    cifra: "8 plantillas CI/CD para todo el portafolio",
    detalle:
      "Azure DevOps parametrizado para Angular, Next.js, PHP, .NET (ECS/EKS), Python serverless (SAM), IA (AgentCore) y SQL, con DevSecOps (Veracode, Trivy, SonarCloud) en todos los pipelines.",
  },
  {
    area: "Seguridad",
    cifra: "10+ vulnerabilidades críticas resueltas",
    detalle:
      "Infraestructura en CloudFormation auditada con AWS Security Hub. La postura de seguridad mejoró 40%.",
  },
  {
    area: "Costos",
    cifra: "USD 800 al mes y 25% menos cómputo",
    detalle:
      "Refactoricé el template padre de CloudFormation eliminando más de 30 recursos redundantes, y una Lambda de autoescalado inteligente para agentes de Azure DevOps.",
  },
  {
    area: "Fiabilidad",
    cifra: "RPO por debajo de 1 hora",
    detalle:
      "Arquitectura multi-región con replicación automática de buckets S3 y tablas DynamoDB globales.",
  },
  {
    area: "Calidad",
    cifra: "Cobertura de código de 0% a 85%",
    detalle:
      "Suite de más de 15 tests unitarios para Lambdas críticas en Python, con Quality Gates de tres niveles en SonarCloud.",
  },
  {
    area: "Mantenibilidad",
    cifra: "50+ templates estandarizados",
    detalle:
      "Documentos SSM convertidos a YAML, más de 200 líneas de duplicación eliminadas y 35% de mejora en mantenibilidad.",
  },
  {
    area: "Automatización",
    cifra: "12 scripts PowerShell",
    detalle:
      "Automatizan el ciclo de vida completo de Work Items en Azure DevOps, con validación de tiempos usando festivos colombianos.",
  },
];

const servicios = [
  {
    herramienta: "Azure DevOps · CloudFormation",
    titulo: "Infraestructura como Código",
    detalle:
      "Diseño y despliegue de arquitecturas resilientes con plantillas CI/CD parametrizadas, environments replicables y promotion gates entre ramas.",
  },
  {
    herramienta: "AWS",
    titulo: "Arquitectura Cloud Native",
    detalle:
      "Arquitectura y despliegue de soluciones escalables y seguras en AWS: landings, redes privadas, IAM con mínimo privilegio y observabilidad.",
  },
  {
    herramienta: "Python · Bash · PowerShell",
    titulo: "Automatización y CI/CD",
    detalle:
      "Pipelines eficientes, integración DevSecOps y automatización de operaciones que reemplazan trabajo manual repetitivo por código testeable.",
  },
];

const stack = [
  "AWS",
  "Azure DevOps",
  "CloudFormation",
  "SAM",
  "EKS",
  "Python",
  "PowerShell",
  "Docker",
  "Git",
];
---

<BaseLayout
  title="Luis Arteaga | Ingeniero DevOps"
  description="Ayudo a empresas a desplegar software más rápido y sin errores automatizando su infraestructura en la nube."
>
  <div class="shell">
    <div class="column">
      <section class="hero">
        <div class="hero-text">
          <h1 class="hero-title">
            Luis Arteaga<br />
            <span class="hero-role">Ingeniero DevOps</span>
          </h1>

          <p class="hero-lede">
            Ayudo a empresas a desplegar software más rápido y sin errores
            automatizando su infraestructura en la nube.
          </p>
        </div>

        <div class="hero-figure">
          <Image
            src={portraitImg}
            alt="Luis Arteaga"
            width={579}
            height={577}
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 62em) 200px, 260px"
            class="hero-portrait"
          />
        </div>
      </section>

      <aside class="rail">
        <dl class="rail-facts">
          <div class="fact">
            <dt>Rol</dt>
            <dd>Ingeniero DevOps</dd>
          </div>
          <div class="fact">
            <dt>Foco</dt>
            <dd>CI/CD · Cloud · Automatización</dd>
          </div>
          <div class="fact">
            <dt>Sector</dt>
            <dd>Banca y logística</dd>
          </div>
          <div class="fact">
            <dt>Base</dt>
            <dd>Montería, Colombia</dd>
          </div>
          <div class="fact">
            <dt>Stack</dt>
            <dd class="rail-stack">{stack.join(" · ")}</dd>
          </div>
        </dl>
        <a class="rail-link" href={CV} download>
          Currículum <span aria-hidden="true">↓</span>
        </a>
      </aside>

      <section class="block">
        <h2 class="block-title">Resultados</h2>
        <p class="block-note">
          Medidos en producción, en banca y logística. El detalle está en <a
            class="text-link"
            href="/about/">acerca de</a
          >.
        </p>
        <ol class="rows">
          {
            resultados.map((r) => (
              <li class="row">
                <p class="row-mark">{r.area}</p>
                <div class="row-body">
                  <h3 class="row-title">{r.cifra}</h3>
                  <p class="row-detail">{r.detalle}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="block">
        <h2 class="block-title">Qué hago</h2>
        <ol class="rows">
          {
            servicios.map((s) => (
              <li class="row">
                <p class="row-mark">{s.herramienta}</p>
                <div class="row-body">
                  <h3 class="row-title">{s.titulo}</h3>
                  <p class="row-detail">{s.detalle}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="block mentions">
        <h2 class="block-title">Menciones</h2>
        <div class="mentions-body">
          <Image
            src={cobisLogo}
            alt="Cobis"
            width={808}
            height={153}
            class="cobis-logo"
          />
          <p class="mentions-text">
            He tenido la suerte de recibir elogios por mi trabajo en varias
            publicaciones.
          </p>
          <a class="text-link" href="/mentions/">Ver todas <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <ContactCTA />
    </div>
  </div>

  <WhatsAppButton />
</BaseLayout>

<style>
  /* ── Hero del inicio ─────────────────────────────────── */
  /* El h1, la entradilla y el ritmo del hero viven en shell.css. Aqui solo
     lo que es propio de esta pagina: el retrato y el indicador de estado. */
  .hero-figure {
    min-width: 0;
    margin-bottom: 0.5rem;
  }

  .hero-text {
    min-width: 0;
  }

  /* La entradilla del hero da el tono; el dato que sigue es la primera cifra. */

  /* El stack vive en el rail como metadato, no como sección: una lista de
     herramientas es evidencia, nunca la afirmación. */
  /* El stack es el unico lugar que conserva la monoespaciada: una lista de
     herramientas se lee como un manifiesto, no como prosa. En minusculas,
     nunca en mayusculas; es la firma tecnica sin volver frio el resto. */
  .rail-stack {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    line-height: 1.75;
    letter-spacing: 0.01em;
  }

  /* Bajo el título de sección, una línea que orienta qué va a leer el
     visitante. Nunca compite con las filas. */
  .block-note {
    max-width: var(--measure);
    margin-bottom: 1.5rem;
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* El retrato ocupa el ancho de la columna de titulos y sostiene su propio
     plano con la elevacion del tema: la sombra es un token, no un literal,
     asi que acompana la temperatura del fondo. */
  .hero-portrait {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    aspect-ratio: 579 / 577;
    object-fit: cover;
    object-position: top;
    border-radius: 1.5rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }

  /* En el inicio el retrato SI ocupa la columna de titulos y el texto la de
     contenido: es la unica pagina donde esa columna tiene una imagen. */
  @media (min-width: 64em) {
    .hero-figure {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-text {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 63.99em) {
    .hero-figure {
      max-width: 15rem;
    }
  }

  /* ── Menciones ────────────────────────────────────────── */
  .mentions-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .cobis-logo {
    width: min(200px, 55vw);
    height: auto;
    opacity: 0.75;
  }

  .mentions-text {
    max-width: 52ch;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
