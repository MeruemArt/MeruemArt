---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import Skills from "../components/Skills.astro";
import TechnicalSkills from "../components/TechnicalSkills.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Grid from "../components/Grid.astro";
import CallToAction from "../components/CallToAction.astro";

import ContactCTA from "../components/ContactCTA.astro";

const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

import { Image } from "astro:assets";
import portraitImg from "../assets/portrait.webp";
import cobisLogo from "../assets/cobis.svg";
---

<BaseLayout
  title="Luis Arteaga | Ingeniero DevOps"
  description="Ayudo a empresas a desplegar software más rápido y sin errores automatizando su infraestructura en la nube."
>
  <div class="wrapper" style="padding-top: 6rem;">
    <section class="hero-section">
      <div class="hero-main animate-in">
        <div class="hero-text">
          <div class="hero-badge" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 1rem; border-radius: 999rem; font-size: 0.85rem; font-weight: 600; background: var(--color-accent); color: #fff; margin-bottom: 1rem; width: fit-content;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #fff; animation: glow-pulse 2s ease-in-out infinite;"></span>
            Disponible para proyectos
          </div>
          <h1 class="hero-title">
            Luis Arteaga<br />
            <span class="gradient-text">Ingeniero DevOps</span>
          </h1>
          <p class="hero-subtitle">
            Ayudo a empresas a desplegar software más rápido y sin errores automatizando su infraestructura en la nube.
          </p>
          <div class="hero-pills">
            <Pill><Icon icon="aws" size="1.2em" /> AWS</Pill>
            <Pill><Icon icon="python" size="1.2em" /> Python</Pill>
            <Pill><Icon icon="git" size="1.2em" /> Git</Pill>
            <Pill><Icon icon="azure_devops" size="1.2em" /> Azure DevOps</Pill>
          </div>
        </div>
        <div class="hero-image-wrapper">
          <div class="hero-glow"></div>
          <Image
            src={portraitImg}
            alt="Luis Arteaga"
            width={480}
            height={620}
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 50em) 280px, 380px"
            class="hero-portrait"
          />
        </div>
      </div>
    </section>

    <Skills />
    <TechnicalSkills />
  </div>

  <main>
    <div class="wrapper" style="padding-top: 3rem;">
      <div class="pdf-section animate-in">
        <object
          data="/assets/CV_Meruem.pdf"
          type="application/pdf"
          width="100%"
          height="600px"
          style="border-radius: 1rem; border: 1px solid var(--color-border);"
        >
          <p style="padding: 2rem; text-align: center;">
            Para obtener una visión más completa de mi experiencia y habilidades,
            <a href="/assets/CV_Meruem.pdf" style="color: var(--color-accent);">descargue mi currículum completo</a>.
          </p>
        </object>
      </div>

      <section class="section-padding mentions-section animate-in">
        <div class="mentions-header">
          <div class="mentions-text">
            <h2 class="section-title">Menciones</h2>
            <p class="section-desc">He tenido la suerte de recibir elogios por mi trabajo en varias publicaciones.</p>
          </div>
          <CallToAction href="/mentions/">
            Ver todo <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>

        <div class="mentions-gallery">
          <Image
            src={cobisLogo}
            alt="Cobis Logo"
            width={808}
            height={153}
            class="cobis-logo"
          />
          <Grid variant="offset">
            {projects.map((project) => (
              <li><PortfolioPreview project={project} /></li>
            ))}
          </Grid>
        </div>
      </section>

      <section class="section-padding services-section animate-in">
        <div class="services-header">
          <h2 class="section-title">Servicios</h2>
          <p class="section-desc">Ofrezco soluciones tecnológicas a medida para potenciar tu negocio.</p>
        </div>

        <div class="services-grid">
          <article class="service-card card-hover">
            <div class="service-icon">
              <Icon icon="terminal-window" size="2.5rem" gradient />
            </div>
            <h3>Infraestructura como Código</h3>
            <p>Diseño y despliegue de arquitecturas resilientes con Azure DevOps y CloudFormation.</p>
          </article>
          <article class="service-card card-hover">
            <div class="service-icon">
              <Icon icon="aws" size="2.5rem" gradient />
            </div>
            <h3>Arquitectura Cloud Native</h3>
            <p>Arquitectura y despliegue de soluciones escalables y seguras en AWS.</p>
          </article>
          <article class="service-card card-hover">
            <div class="service-icon">
              <Icon icon="python" size="2.5rem" gradient />
            </div>
            <h3>Automatización y CI/CD</h3>
            <p>Pipelines eficientes y scripting para operaciones con Python y Bash.</p>
          </article>
        </div>
      </section>

    </div>

    <ContactCTA />
  </main>
</BaseLayout>

<style>
  .hero-section {
    padding: 2rem 0 3rem;
  }

  .hero-main {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 2rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .hero-subtitle {
    max-width: 40ch;
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .hero-image-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .hero-glow {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: var(--color-accent-glow);
    filter: blur(40px);
    animation: glow-pulse 3s ease-in-out infinite;
    z-index: -1;
  }

  .hero-portrait {
    width: min(280px, 60vw);
    height: auto;
    aspect-ratio: 9 / 8.8;
    object-fit: cover;
    object-position: top;
    border-radius: 45% 55% 63% 37% / 47% 53% 47% 53%;
  }

  .mentions-section {
    border-top: 1px solid var(--color-border);
  }

  .mentions-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 0.5rem;
  }

  .section-desc {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    max-width: 40ch;
  }

  .mentions-gallery {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cobis-logo {
    max-height: 3rem;
    width: auto;
    align-self: flex-start;
    opacity: 0.7;
  }

  .services-section {
    border-top: 1px solid var(--color-border);
  }

  .services-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .services-header .section-desc {
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    gap: 1.5rem;
  }

  .service-card {
    padding: 2rem;
    background: var(--color-surface-secondary);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--color-accent-glow);
    margin-bottom: 0.5rem;
  }

  .service-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .service-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (min-width: 50em) {
    .hero-main {
      flex-direction: row;
      justify-content: space-between;
      gap: 4rem;
    }

    .hero-text {
      align-items: flex-start;
      text-align: left;
      flex: 1;
    }

    .hero-pills {
      justify-content: flex-start;
    }

    .hero-image-wrapper {
      flex-shrink: 0;
    }

    .hero-portrait {
      width: 380px;
    }

    .mentions-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }

    .services-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .pdf-section {
      max-width: 48rem;
      margin: 0 auto;
    }
  }
</style>
