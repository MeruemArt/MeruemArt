---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscás no existe o cambió de dirección.">
  <div class="shell">
    <aside class="rail">
      <p class="rail-label">Error</p>
      <p class="rail-value">404</p>
    </aside>

    <div class="column">
      <section class="block">
        <p class="error-code">404</p>
        <h1 class="error-title">Esta página no existe</h1>
        <p class="error-text">
          El enlace puede estar roto o la dirección haber cambiado. Te dejo el camino de vuelta.
        </p>
        <div class="error-actions">
          <a class="btn-primary" href="/">Volver al inicio</a>
          <a class="btn-quiet" href="/work/">Ver el trabajo</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .error-code {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .error-title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .error-text {
    max-width: 46ch;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
