---
import { CollectionEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import SocialShare from "../../components/SocialShare.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";

interface Props {
  entry: CollectionEntry<"work">;
}

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const year = entry.data.publishDate.getFullYear();
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="shell">
    <div class="column">
      <article>
        <header class="hero">
          <h1 class="hero-title">{entry.data.title}</h1>
          <p class="hero-lede">{entry.data.description}</p>
          <div class="work-share">
            <SocialShare
              title={entry.data.title}
              description={entry.data.description}
            />
          </div>
        </header>

        <aside class="rail">
          <dl class="rail-facts">
            <div class="fact">
              <dt>Tipo</dt>
              <dd>Trabajo</dd>
            </div>
            <div class="fact">
              <dt>Año</dt>
              <dd>{year}</dd>
            </div>
            <div class="fact">
              <dt>Stack</dt>
              <dd>{entry.data.tags.join(" · ")}</dd>
            </div>
          </dl>
          <a class="rail-link" href="/">
            Volver al inicio <span aria-hidden="true">→</span>
          </a>
        </aside>

        {
          entry.data.img && (
            <Image
              src={entry.data.img}
              alt={entry.data.img_alt || ""}
              loading="eager"
              format="webp"
              quality={85}
              class="work-image"
            />
          )
        }

        <div class="work-body">
          <Content />
        </div>
      </article>

      <ContactCTA />
    </div>
  </div>

  <WhatsAppButton />
</BaseLayout>

<style>
  /* El hero vive en shell.css. Aqui solo lo especifico del detalle de
     trabajo: la imagen, el cuerpo de prosa y los enlaces de compartir. */

  .work-share {
    margin-top: 1.75rem;
  }

  .work-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sheet-lg, 1.25rem);
    border: 1px solid var(--color-border-light);
    margin-bottom: 2.5rem;
  }

  .work-body {
    max-width: 58ch;
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .work-body :global(h1),
  .work-body :global(h2),
  .work-body :global(h3) {
    margin: 2.5rem 0 1rem;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .work-body :global(img) {
    border-radius: 0.75rem;
    margin: 1.75rem 0;
    border: 1px solid var(--color-border-light);
  }

  /* Filete neutro en vez de una slab de acento de 3px: la cita se distingue
     por la profundidad y la itálica, no por un borde de color. */
  .work-body :global(blockquote) {
    border-left: 1px solid var(--color-border);
    padding-left: 1.25rem;
    margin: 1.75rem 0;
    color: var(--color-text-primary);
    font-style: italic;
  }

  .work-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .work-body :global(code) {
    background: var(--color-surface-secondary);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  .work-body :global(ul),
  .work-body :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }

  .work-body :global(li) {
    margin-bottom: 0.4rem;
  }
</style>
