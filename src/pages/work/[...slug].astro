---
import { CollectionEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Icon from "../../components/Icon.astro";
import Pill from "../../components/Pill.astro";
import SocialShare from "../../components/SocialShare.astro";
import ContactCTA from "../../components/ContactCTA.astro";

interface Props {
  entry: CollectionEntry<"work">;
}

export async function getStaticPaths() {
  const work = await getCollection("work");
  return work.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="wrapper" style="padding-top: 6rem;">
    <article>
      <header class="work-header animate-in">
        <a class="back-link" href="/mentions/">
          <Icon icon="arrow-left" size="1em" /> Volver a Menciones
        </a>
        <Hero title={entry.data.title} size="md" align="start">
          <div class="work-meta">
            <div class="work-tags">
              {entry.data.tags.map((t) => <Pill variant="subtle">{t}</Pill>)}
            </div>
            <p class="work-description">{entry.data.description}</p>
            <SocialShare
              title={entry.data.title}
              description={entry.data.description}
            />
          </div>
        </Hero>
      </header>

      <div class="work-content animate-in">
        {entry.data.img && (
          <Image
            src={entry.data.img}
            alt={entry.data.img_alt || ""}
            loading="eager"
            format="webp"
            quality={85}
            class="work-image"
          />
        )}
        <div class="work-body">
          <Content />
        </div>
      </div>
    </article>
  </div>

  <ContactCTA />
</BaseLayout>

<style>
  .work-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-tertiary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .work-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .work-description {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 48ch;
    line-height: 1.6;
  }

  .work-content {
    max-width: 48rem;
    margin: 0 auto;
  }

  .work-image {
    border-radius: 1.25rem;
    margin-bottom: 2rem;
    border: 1px solid var(--color-border);
  }

  .work-body {
    max-width: 65ch;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .work-body :global(h1),
  .work-body :global(h2),
  .work-body :global(h3) {
    margin: 2rem 0 1rem;
    color: var(--color-text-primary);
  }

  .work-body :global(img) {
    border-radius: 1rem;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .work-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-text-primary);
    font-style: italic;
  }

  .work-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .work-body :global(code) {
    background: var(--color-surface-secondary);
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  @media (min-width: 50em) {
    .work-meta {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
    }

    .work-description {
      flex: 1;
    }
  }
</style>
