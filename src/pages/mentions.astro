---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCTA from "../components/ContactCTA.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

const images = Array.from(
  { length: 9 },
  (_, i) => `/assets/mentions/starmeup-${i + 1}.png`,
);
---

<BaseLayout
  title="Menciones | Luis Arteaga"
  description="Reconocimientos y felicitaciones que ha recibido mi trabajo en prensa y publicaciones."
>
  <div class="shell">
    <div class="column">
      <section class="hero">
        <h1 class="hero-title">Menciones</h1>
        <p class="hero-lede">
          Reconocimientos y felicitaciones que ha recibido mi trabajo en
          prensa y publicaciones, con años de trayectoria en banca y
          logística.
        </p>
      </section>

      <aside class="rail">
        <dl class="rail-facts">
          <div class="fact">
            <dt>Tipo</dt>
            <dd>Prensa y publicaciones</dd>
          </div>
          <div class="fact">
            <dt>Total</dt>
            <dd>{images.length} menciones</dd>
          </div>
        </dl>
        <a class="rail-link" href="/">
          Volver al inicio <span aria-hidden="true">→</span>
        </a>
      </aside>

      <ul class="mentions">
        {
          images.map((src, i) => (
            <li>
              <figure>
                <img
                  src={src}
                  alt={`Mención ${i + 1} de ${images.length}`}
                  width="610"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </li>
          ))
        }
      </ul>

      <ContactCTA />
    </div>
  </div>

  <WhatsAppButton />
</BaseLayout>

<style>
  /* El hero vive en shell.css. Aqui solo la grilla de menciones. */

  /* Sin card chrome: la imagen va directa sobre la superficie, con un filete
     en vez de una caja con sombra permanente. */
  .mentions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 2rem 1.5rem;
    list-style: none;
    margin: 0 0 3.5rem;
    padding: 0;
  }

  .mentions figure {
    margin: 0;
  }

  .mentions img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border-light);
  }
</style>
