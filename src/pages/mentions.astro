---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { Image } from 'astro:assets';
import whatsappIcon from '../assets/whatsapp-icon.svg';

const images = Array.from({ length: 9 }, (_, i) => `/assets/mentions/starmeup-${i + 1}.png`);
---

<BaseLayout
  title="Menciones | Luis Arteaga"
  description="Menciones y felicitaciones en mi trabajo."
>
  <div class="wrapper" style="padding-top: 6rem;">
    <Hero
      title="Menciones"
      tagline="Menciones y felicitaciones en mi trabajo."
      align="start"
    />

    <div class="mentions-grid animate-in">
      {images.map((src) => (
        <div class="mention-card">
          <img src={src} alt="Reconocimiento" loading="lazy" />
        </div>
      ))}
    </div>
  </div>

  <a
    href="https://web.whatsapp.com/send/?phone=%2B573186405618&text=Hola+Luis.%0AVi+tu+p%C3%A1gina%2C+me+interesa+contactarte+%F0%9F%91%A8%F0%9F%8F%BB%E2%80%8D%F0%9F%92%BB.&type=phone_number&app_absent=0"    class="whatsapp-button"
    target="_blank"
  >
    <Image
      src={whatsappIcon}
      alt="Icono de Whatsapp"
      width={64}
      height={64}
      loading="eager"
    />
  </a>
  <ContactCTA />
</BaseLayout>

<style>
  .mentions-grid {
    padding: 2rem 0 4rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .mention-card {
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: transform 0.2s;
  }
  .mention-card:hover {
    transform: translateY(-4px);
  }
  .mention-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  .whatsapp-button {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 220;
  }

  .whatsapp-button img {
    width: 56px;
    height: 56px;
  }

  @media (min-width: 50em) {
    .whatsapp-button img {
      width: 64px;
      height: 64px;
    }
  }
</style>
