---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactCTA from '../components/ContactCTA.astro';

const images = Array.from({ length: 9 }, (_, i) => `/assets/mentions/starmeup-${i + 1}.png`);
---

<BaseLayout
  title="Menciones | Luis Arteaga"
  description="Menciones y felicitaciones en mi trabajo."
>
  <div class="wrapper" style="padding-top: 6rem;">
    <Hero
      title="Menciones"
      tagline="Menciones y felicitaciones en mi trabajo."
      align="start"
    />

    <div class="mentions-grid animate-in">
      {images.map((src) => (
        <div class="mention-card">
          <img src={src} alt="Reconocimiento" loading="lazy" />
        </div>
      ))}
    </div>
  </div>

  <ContactCTA />
</BaseLayout>

<style>
  .mentions-grid {
    padding: 2rem 0 4rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .mention-card {
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: transform 0.2s;
  }
  .mention-card:hover {
    transform: translateY(-4px);
  }
  .mention-card img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
